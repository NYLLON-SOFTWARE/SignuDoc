# A site made with the "Deploy with Vercel" button needs nothing from this
# file: Vercel connects the database, the file store and email by itself.
# The three settings below are what local development needs. Everything
# after them is optional.

# Postgres. `npm run db:start` runs one locally with these credentials.
DATABASE_URL=postgres://signudoc:signudoc@127.0.0.1:5432/signudoc

# Public URL of the app, used for links, auth callbacks, and emails.
# On Vercel, leave this unset: the project's own domain is used.
APP_URL=http://localhost:3000

# "capture" writes each email to .data/outbox as JSON instead of sending it,
# which is all local development needs. Remove this line, or set "resend",
# to send through Resend with the key below.
EMAIL_DRIVER=capture

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Resend API key, for sending real email. On Vercel the Resend integration
# sets it.
# RESEND_API_KEY=

# The address email is sent from and the address replies go to are chosen
# in the app, under Settings, Organization. Set these only to fix them from
# the environment instead; they then cannot be changed in the app.
# RESEND_FROM_EMAIL=
# SUPPORT_EMAIL=

# BETTER_AUTH_URL defaults to APP_URL. BETTER_AUTH_SECRET defaults to a
# value derived from the database password; set your own (for example with
# `openssl rand -hex 32`) if you want sign-ins to survive a database
# password change. In production a derived secret needs a database password
# of at least 12 characters.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=

# The first person to open a new install sets it up at /setup and becomes
# its administrator. Set a secret here and the setup page asks for it, so
# that finding the URL first is not enough. It is also what lets a
# signed-in user take charge of an install that has accounts but no
# administrator.
# SETUP_TOKEN=

# The daily cleanup at /api/internal/retention is safe to leave open: it
# runs at most once an hour and tells the caller nothing. Set a secret to
# close it to everyone who does not send it as a bearer token. On Vercel use
# CRON_SECRET, which Vercel sends on its own cron calls.
# RETENTION_JOB_SECRET does the same for a scheduler of your own elsewhere.
# CRON_SECRET=
# RETENTION_JOB_SECRET=

# Vercel only. BOTID=1 turns on Vercel BotID for sign-in, sign-up, password
# reset, the contact form and first-run setup. It is read when the app is
# built, so redeploy after changing it. See "Bot protection" in the README
# before turning it on.
# BOTID=

# HOSTED_MODE=1 runs SignuDoc as a public service under its own name:
# landing page, built-in terms and privacy pages, sign-up open to anyone.
# Leave it unset for an install that belongs to one organization.
# HOSTED_MODE=

# File storage. Unset, PDFs are kept on this machine under .data/storage
# (STORAGE_LOCAL_DIR changes where). On Vercel, connect a Blob store to the
# project and leave this unset: the store is picked up by itself.
# STORAGE_DRIVER=blob or =local forces one.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=

# Resend region for the sending domain the app adds for you: us-east-1
# (default), eu-west-1, sa-east-1 or ap-northeast-1. Use eu-west-1 to send
# from the EU. See "Running in the EU" in the README.
# RESEND_REGION=

# The seal on finished PDFs. Unset, the install makes its own key and
# self-signed certificate on first use (kept encrypted in the database with
# a key derived from BETTER_AUTH_SECRET, so keep that secret stable). To
# seal with a certificate from a certificate authority instead, give it as
# a base64 PKCS#12 (.p12) file and its password.
# SEAL_P12_BASE64=
# SEAL_P12_PASSWORD=

# An RFC 3161 timestamp server, to add a trusted time to each seal, for
# example http://timestamp.digicert.com. If the server cannot be reached,
# the PDF is sealed without a timestamp.
# SEAL_TIMESTAMP_URL=

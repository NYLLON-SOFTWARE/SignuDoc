# Postgres. `npm run db:start` runs one locally with these credentials.
DATABASE_URL=postgres://signudoc:signudoc@127.0.0.1:5432/signudoc

# Public URL of the app, used for links, auth callbacks, and emails.
# On Vercel, leave this unset: the project's own domain is used.
APP_URL=http://localhost:3000

# Optional. BETTER_AUTH_URL defaults to APP_URL. BETTER_AUTH_SECRET defaults
# to a value derived from the database password; set your own (for example
# with `openssl rand -hex 32`) if you want sign-ins to survive a database
# password change.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=

# Shared secret for the internal retention job route.
RETENTION_JOB_SECRET=replace-with-internal-retention-job-secret

# Email. "capture" writes each email to .data/outbox as JSON instead of
# sending it, which is all local development needs. Use "resend" to send.
EMAIL_DRIVER=capture
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=replace-with-resend-from-email
SUPPORT_EMAIL=replace-with-support-email

# File storage. "local" keeps PDFs under .data/storage. Use "r2" for
# Cloudflare R2 and fill in the four values below.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
